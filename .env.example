# ── 基本 ──
APP_ENV=dev                      # dev | prod
DEV_MODE=true                    # true 时启用 dev-login、mock 知乎、admin/reseed
PUBLIC_BASE_URL=http://localhost:8000
# Docker 宿主机映射端口；容器内端口固定为 8000
APP_PORT=8000
TZ=Asia/Shanghai
LOG_LEVEL=info

# ── 安全 ──
SESSION_SECRET=dev-session-secret-change-me-in-prod
TOKEN_ENC_KEY=                   # python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ADMIN_TOKEN=dev-admin-token
JUDGE_ACCOUNTS=judge1:changeme1,judge2:changeme2

# ── 存储 ──
# 本机开发用相对路径；docker compose 里会被强制为 /data/pc.db（落卷）
DATABASE_URL=sqlite+aiosqlite:///./data/pc.db

# ── 知乎 ──
ZHIHU_ACCESS_SECRET=
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=
ZHIHU_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/zhihu/callback

# ── LLM（OpenAI 兼容）──
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL_STRONG=deepseek-chat
LLM_MODEL_CHEAP=deepseek-chat
LLM_TIMEOUT=25
LLM_SUPPORTS_JSON_MODE=true

# ── 模拟旋钮（见 spec/04 §10）──
TICK_SECONDS_ONLINE=20
TICK_SECONDS_IDLE=300
MAX_CONCURRENT_LLM=8
MAX_DECISIONS_PER_TICK=10
SPONTANEITY=0.15
STIMULUS_DECIDE_PROB=0.6
HOT_PULL_INTERVAL_MIN=60
HOT_DAILY_CAP=24
ZHIDA_DAILY_CAP=50
SEARCH_DAILY_CAP=200
WHISPERS_PER_DAY=3
